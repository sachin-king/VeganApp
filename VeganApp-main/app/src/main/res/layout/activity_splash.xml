<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Top Logo Section -->
    <LinearLayout
        android:id="@+id/topSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:gravity="center">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_leaf"
            android:scaleType="centerInside"/>

        <TextView
            android:layout_marginTop="10dp"
            android:text="Veganza"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:letterSpacing="0.05"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Food Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardFood"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_below="@id/topSection"
        android:layout_margin="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

<!--        <ImageView-->
<!--            android:id="@+id/foodImage"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="match_parent"-->
<!--            android:src="@drawable/malai_kofta"-->
<!--            android:scaleType="centerCrop"/>-->
        <ImageView
            android:id="@+id/splashImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

    </androidx.cardview.widget.CardView>

    <!-- Description -->
    <TextView
        android:id="@+id/descText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardFood"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"

        android:text="Heritage spices, contemporary plant-based craft."
        android:textColor="#444"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"

        android:padding="14dp"
        android:background="@drawable/bg_desc"
        android:elevation="4dp"/>


    <!-- Button -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="260dp"
        android:layout_height="55dp"
        android:text="Explore Veganza →"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="60dp"
        android:backgroundTint="#1B5E20"
        android:elevation="6dp"/>

</RelativeLayout>





